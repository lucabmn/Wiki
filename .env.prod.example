# Production root .env — copy to `.env` and fill in.
#
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# The installer TUI (`pnpm dev:tui` → Installieren) writes POSTGRES_PASSWORD and
# the VITE_* vars for you; the domain vars below are only needed for the prod
# overlay + Caddy and must be added by hand.

# ── Domains (Caddy auto-provisions TLS for each) ─────────────────────────────
WEB_DOMAIN=wiki.example.com
API_DOMAIN=api.example.com
COLLAB_DOMAIN=collab.example.com
ACME_EMAIL=admin@example.com

# ── Postgres password (compose interpolates this) ────────────────────────────
POSTGRES_PASSWORD=change-me

# ── Public URLs baked into the web bundle at BUILD time ──────────────────────
# Must match the domains above. Changing these requires a rebuild.
VITE_SERVER_URL=https://api.example.com
VITE_COLLAB_URL=wss://collab.example.com

# Reminder — set these in apps/server/.env and apps/collab/.env too (the TUI does
# this from the install form; https is mandatory or auth cookies are rejected):
#   BETTER_AUTH_URL=https://api.example.com
#   CORS_ORIGIN=https://wiki.example.com
