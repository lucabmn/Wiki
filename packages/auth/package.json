    "better-auth": "catalog:",
    "better-auth-localization": "^3.0.0",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nilovon-wiki/config": "workspace:*",
    "typescript": "catalog:"
  }
}
