# Root .env — the single configuration file for a Docker-based install.
# Easiest path: run the installer (binary from GitHub Releases, or `pnpm dev:tui`
# from the checkout); it writes this file with strong generated secrets.
#
# Manual path: copy to `.env`, fill in the secrets, then
#   local:      docker compose up -d --build
#   production: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build

# ── Secrets (required) ────────────────────────────────────────────────────────
# Generate each with: openssl rand -base64 48
# Placeholder values are rejected at startup on purpose.
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
# Bundled RustFS credentials. Generate unique values; do not use vendor defaults.
# Suggested: openssl rand -hex 16 / openssl rand -base64 32
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Production only (used by the prod overlay + Caddy) ────────────────────────
# Caddy auto-provisions TLS certificates for each domain via Let's Encrypt.
#WEB_DOMAIN=wiki.example.com
#API_DOMAIN=api.wiki.example.com
#COLLAB_DOMAIN=collab.wiki.example.com
#ACME_EMAIL=admin@example.com

# Public URLs. The VITE_* values are baked into the web bundle at BUILD time —
# changing them requires `docker compose ... up -d --build web`.
# ── Instance administration ───────────────────────────────────────────────────
# Who gets the admin console at /admin. On a fresh install nobody has the
# instance role, so the first admin has to be named here — the server promotes
# this address at start, and stamps the role at registration if the account does
# not exist yet. Both are idempotent and never demote anyone. Further admins are
# appointed inside the console. See DEPLOY.md.
#INITIAL_ADMIN_EMAIL=admin@example.com
#
# Support impersonation. Bounded and audited on both ends; set to false where
# the capability has to be provably absent rather than merely logged.
#IMPERSONATION_ENABLED=true
#IMPERSONATION_MAX_MINUTES=30

# ── Registration policy ───────────────────────────────────────────────────────
# Who may create an account with email and password. The default is `open`,
# which suits a public community wiki. A private, organization-internal wiki
# wants `invite` — otherwise anyone who can reach the sign-up page can open an
# account on it.
#
#   open    anyone who reaches the form
#   invite  only addresses with a pending organization invitation
#   closed  nobody; an instance admin creates accounts, or an identity
#           provider pushes them
#
# INITIAL_ADMIN_EMAIL is exempt in every mode, so a fresh instance set to
# `closed` can still be bootstrapped. SSO sign-in and SCIM directory sync are
# unaffected: an admin configured those, which is itself the invitation.
#SIGNUP_MODE=invite
#
# Optional allowlist of mail domains that may register, comma-separated. Matched
# exactly and case-insensitively — `example.com` does not cover
# `sub.example.com`. Bounds self-service registration only; an invitation to
# another domain is still honoured, because somebody with the authority to
# invite deliberately sent it.
#SIGNUP_ALLOWED_EMAIL_DOMAINS=example.com,example.org
#
# Require a confirmed address before the account can sign in. Needs SMTP below —
# the server refuses to start without it rather than creating accounts nobody
# can ever use.
#REQUIRE_EMAIL_VERIFICATION=true

# ── Mail (optional) ───────────────────────────────────────────────────────────
# Without SMTP_HOST the app still boots, but invitations, password resets and
# address verification are not delivered. Their authentication links are never logged.
# Dev tip: `docker compose --profile dev up -d mailpit`, then SMTP_HOST=mailpit
# and SMTP_PORT=1025 — the inbox is at http://localhost:8025.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_SECURE=false          # true only for implicit TLS on port 465
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_FROM=Wiki <wiki@example.com>

# ── Bundled notifications (digests) ───────────────────────────────────────────
# One summary mail per period instead of one per change. Admins set the defaults
# for their organization in the app (Einstellungen → Organisation →
# Benachrichtigungen); members may override them for themselves. Nothing is
# delivered without SMTP above — and no events are lost meanwhile, because the
# runner does not advance its cursor while mail is unconfigured.
#
# The server runs the schedule itself. Turn the in-process ticker off where the
# process is not long-lived (serverless) or where several replicas run and an
# external scheduler should drive it instead.
#DIGEST_SCHEDULER_ENABLED=true
#DIGEST_TICK_SECONDS=300     # how often to look for due digests
# Enables the POST /internal/…/run endpoints for an external cron (digests,
# webhooks and retention all share it). Unset = disabled.
# Generate with: openssl rand -base64 32
# The older, digest-specific DIGEST_RUN_TOKEN still works as an alias.
#INTERNAL_RUN_TOKEN=

# ── Outbound webhooks ─────────────────────────────────────────────────────────
# Events leave the wiki as signed HTTP POSTs. Nothing to configure to use them —
# org admins add endpoints in the settings UI. These only tune the runner.
#WEBHOOK_SCHEDULER_ENABLED=true
#WEBHOOK_TICK_SECONDS=30       # how often to look for queued deliveries
#WEBHOOK_TIMEOUT_SECONDS=10    # per request; a stalled receiver must not block
#WEBHOOK_MAX_ATTEMPTS=6        # then the delivery is marked failed
# Endpoints in the private network (localhost, 10.x, cloud metadata) are refused
# by default. Only turn this on for a single-tenant install whose receiver
# genuinely lives on the internal network.
#WEBHOOK_ALLOW_PRIVATE_HOSTS=false

# ── Data retention (audit window, trash expiry) ───────────────────────────────
# What is kept and for how long is configured per organization in the app
# (Einstellungen → Daten & Fristen). The defaults are deliberately conservative:
# the activity log is kept forever and the trash holds deleted pages for 30 days.
# Nothing here shortens those windows — this only controls the runner that
# enforces whatever an admin has set.
#RETENTION_SCHEDULER_ENABLED=true
#RETENTION_TICK_SECONDS=3600  # retention windows are days; hourly is plenty
# Rows removed per category per run. The ceiling is what keeps a first run over a
# long-unbounded audit log from issuing one DELETE over millions of rows.
#RETENTION_BATCH_LIMIT=1000

# ── Data retention (audit window, trash expiry) ───────────────────────────────
# What is kept and for how long is configured per organization in the app
# (Einstellungen → Daten & Fristen). The defaults are deliberately conservative:
# the activity log is kept forever and the trash holds deleted pages for 30 days.
# Nothing here shortens those windows — this only controls the runner that
# enforces whatever an admin has set.
#
# The server runs the schedule itself; turn the ticker off where the process is
# not long-lived (serverless) or an external scheduler drives
# POST /internal/retention/run instead. The runner claims work per organization
# in the database, so both triggers — and several replicas — cannot delete twice.
#RETENTION_SCHEDULER_ENABLED=true
#RETENTION_TICK_SECONDS=3600  # retention windows are days; hourly is plenty
# Rows removed per category per run. The ceiling is what keeps a first run over a
# long-unbounded audit log from issuing one DELETE over millions of rows.
#RETENTION_BATCH_LIMIT=1000

# ── Attachment storage ────────────────────────────────────────────────────────
# The required credentials above protect the bundled RustFS service. To use an
# external S3-compatible store, keep them aligned with that store and override
# the endpoint/bucket below. The API proxies uploads and downloads, so the store
# never needs to be browser-reachable.
#S3_BUCKET=nilovon-wiki
#S3_ENDPOINT=http://rustfs:9000
#S3_REGION=us-east-1
#S3_FORCE_PATH_STYLE=true   # false only for real AWS S3 (virtual-host buckets)
#ATTACHMENT_MAX_MB=25       # per-file upload ceiling

# ── PDF export (optional) ─────────────────────────────────────────────────────
# PDFs are rendered in-process — no headless browser, no extra container — so
# these ceilings bound what one export request may cost the API. Pages beyond
# them are never dropped silently: they get a placeholder page and a report
# entry in the archive. See docs/export-format.md.
#PDF_EXPORT_MAX_PAGES=500        # pages rendered per Space export
#PDF_EXPORT_PAGE_TIMEOUT_MS=15000 # wall-clock budget per page
#PDF_EXPORT_IMAGE_CACHE_MB=64    # ceiling for the per-export image cache

# ── Rate limits and branding (optional) ───────────────────────────────────────
# Per-IP ceilings in requests per minute. Set high enough that normal usage
# never reaches them; the auth limit is what blunts credential stuffing, and the
# SCIM one is sized for an identity provider pushing a whole directory at once.
#RATE_LIMIT_MAX=600
#RATE_LIMIT_AUTH_MAX=60
#RATE_LIMIT_SCIM_MAX=1200
# Display name in mails and passkey prompts.
#APP_NAME=Wiki

# ── Container resource limits (optional) ──────────────────────────────────────
# Hard ceilings per service. The defaults are sized so normal operation never
# comes close; they exist so one runaway process cannot take the host down.
#
# Raise them rather than remove them. If a service is being OOM-killed, the
# limit is telling you something real — for the API that is usually a large PDF
# export, which the PDF_EXPORT_* ceilings above are the better lever for.
#SERVER_MEMORY_LIMIT=1g
#WEB_MEMORY_LIMIT=512m
#COLLAB_MEMORY_LIMIT=512m    # scales with pages edited at once, not wiki size
#POSTGRES_MEMORY_LIMIT=2g    # raise before tuning shared_buffers
#RUSTFS_MEMORY_LIMIT=1g
#CADDY_MEMORY_LIMIT=256m     # production overlay only

# ── Backups (optional but strongly recommended) ───────────────────────────────
# `docker compose --profile backup up -d --build backup` writes one *recovery
# set* per run into the nilovon-wiki_backups volume: the database dump AND every
# attachment byte under one timestamp, with SHA-256 checksums over both. A
# database dump on its own restores a wiki whose attachments all 404.
#
# The container reports itself unhealthy once the newest successful backup is
# older than BACKUP_MAX_AGE_SECONDS, so a silently broken backup shows up in
# `docker compose ps` instead of during a restore. See DEPLOY.md → Backups.
#BACKUP_KEEP_DAYS=14           # local retention
#BACKUP_INTERVAL_SECONDS=86400 # daily
#BACKUP_MAX_AGE_SECONDS=129600 # 36 h — tolerates one late run, flags the second
#
# At-rest encryption. Optional, and a passphrase nobody wrote down turns every
# backup into a very thorough deletion — store it somewhere other than this host
# before setting it.
#BACKUP_PASSPHRASE=
#
# Offsite copy to any S3-compatible target. Without it, backups survive a bad
# deploy and nothing else — not a lost disk, not a lost host, not ransomware.
# Give these credentials write-but-not-delete rights and set the retention on
# the remote's own lifecycle policy, where a compromised host cannot reach it.
#BACKUP_REMOTE_ENDPOINT=https://s3.eu-central-1.amazonaws.com
#BACKUP_REMOTE_BUCKET=my-wiki-backups
#BACKUP_REMOTE_PREFIX=nilovon-wiki
#BACKUP_REMOTE_ACCESS_KEY_ID=
#BACKUP_REMOTE_SECRET_ACCESS_KEY=

#BETTER_AUTH_URL=https://api.wiki.example.com
#CORS_ORIGIN=https://wiki.example.com
# Scopes the auth cookie to the shared parent so the web app's SSR middleware
# sees the session the API issued. Only set it when both hosts share a real
# registrable parent domain — leave unset otherwise.
#COOKIE_DOMAIN=.wiki.example.com
#VITE_SERVER_URL=https://api.wiki.example.com
#VITE_COLLAB_URL=wss://collab.wiki.example.com
