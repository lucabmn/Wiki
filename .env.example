# Root .env — the single configuration file for a Docker-based install.
# Easiest path: run the installer (binary from GitHub Releases, or `pnpm dev:tui`
# from the checkout); it writes this file with strong generated secrets.
#
# Manual path: copy to `.env`, fill in the secrets, then
#   local:      docker compose up -d --build
#   production: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build

# ── Secrets (required) ────────────────────────────────────────────────────────
# Generate each with: openssl rand -base64 48
# Placeholder values are rejected at startup on purpose.
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
# Bundled RustFS credentials. Generate unique values; do not use vendor defaults.
# Suggested: openssl rand -hex 16 / openssl rand -base64 32
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Production only (used by the prod overlay + Caddy) ────────────────────────
# Caddy auto-provisions TLS certificates for each domain via Let's Encrypt.
#WEB_DOMAIN=wiki.example.com
#API_DOMAIN=api.wiki.example.com
#COLLAB_DOMAIN=collab.wiki.example.com
#ACME_EMAIL=admin@example.com

# Public URLs. The VITE_* values are baked into the web bundle at BUILD time —
# changing them requires `docker compose ... up -d --build web`.
# ── Mail (optional) ───────────────────────────────────────────────────────────
# Without SMTP_HOST the app still boots, but invitations, password resets and
# address verification are not delivered. Their authentication links are never logged.
# Dev tip: `docker compose --profile dev up -d mailpit`, then SMTP_HOST=mailpit
# and SMTP_PORT=1025 — the inbox is at http://localhost:8025.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_SECURE=false          # true only for implicit TLS on port 465
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_FROM=Wiki <wiki@example.com>

# ── Bundled notifications (digests) ───────────────────────────────────────────
# One summary mail per period instead of one per change. Admins set the defaults
# for their organization in the app (Einstellungen → Organisation →
# Benachrichtigungen); members may override them for themselves. Nothing is
# delivered without SMTP above — and no events are lost meanwhile, because the
# runner does not advance its cursor while mail is unconfigured.
#
# The server runs the schedule itself. Turn the in-process ticker off where the
# process is not long-lived (serverless) or where several replicas run and an
# external scheduler should drive it instead.
#DIGEST_SCHEDULER_ENABLED=true
#DIGEST_TICK_SECONDS=300     # how often to look for due digests
# Enables the POST /internal/…/run endpoints for an external cron (digests and
# webhooks share it). Unset = disabled. Generate with: openssl rand -base64 32
# The older, digest-specific DIGEST_RUN_TOKEN still works as an alias.
#INTERNAL_RUN_TOKEN=

# ── Outbound webhooks ─────────────────────────────────────────────────────────
# Events leave the wiki as signed HTTP POSTs. Nothing to configure to use them —
# org admins add endpoints in the settings UI. These only tune the runner.
#WEBHOOK_SCHEDULER_ENABLED=true
#WEBHOOK_TICK_SECONDS=30       # how often to look for queued deliveries
#WEBHOOK_TIMEOUT_SECONDS=10    # per request; a stalled receiver must not block
#WEBHOOK_MAX_ATTEMPTS=6        # then the delivery is marked failed
# Endpoints in the private network (localhost, 10.x, cloud metadata) are refused
# by default. Only turn this on for a single-tenant install whose receiver
# genuinely lives on the internal network.
#WEBHOOK_ALLOW_PRIVATE_HOSTS=false

# ── Attachment storage ────────────────────────────────────────────────────────
# The required credentials above protect the bundled RustFS service. To use an
# external S3-compatible store, keep them aligned with that store and override
# the endpoint/bucket below. The API proxies uploads and downloads, so the store
# never needs to be browser-reachable.
#S3_BUCKET=nilovon-wiki
#S3_ENDPOINT=http://rustfs:9000
#S3_REGION=us-east-1
#S3_FORCE_PATH_STYLE=true   # false only for real AWS S3 (virtual-host buckets)
#ATTACHMENT_MAX_MB=25       # per-file upload ceiling

# ── Backups (optional) ────────────────────────────────────────────────────────
# `docker compose --profile backup up -d backup` dumps the database nightly into
# the nilovon-wiki_backups volume. Attachment bytes are not included.
#BACKUP_KEEP_DAYS=14

#BETTER_AUTH_URL=https://api.wiki.example.com
#CORS_ORIGIN=https://wiki.example.com
# Scopes the auth cookie to the shared parent so the web app's SSR middleware
# sees the session the API issued. Only set it when both hosts share a real
# registrable parent domain — leave unset otherwise.
#COOKIE_DOMAIN=.wiki.example.com
#VITE_SERVER_URL=https://api.wiki.example.com
#VITE_COLLAB_URL=wss://collab.wiki.example.com
