{
  "name": "tui",
  "private": true,
  "type": "module",
  "module": "src/index.tsx",
  "scripts": {
    "dev": "bun run --watch src/index.tsx",
    "compile": "bun build --compile --production --define 'process.env.OPENTUI_LIBC=\"glibc\"' src/index.tsx --outfile dist/nilovon-wiki-installer",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@opentui/core": "^0.4.3",
    "@opentui/react": "^0.4.3",
    "react": "^19.2.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
