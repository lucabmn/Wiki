# Committed on purpose. `@nilovon-wiki/env/web` validates `import.meta.env` at
# module load, which Vite populates from the .env files — so without this a
# fresh clone with no `apps/web/.env` fails every test that transitively
# imports the client env ("Invalid environment variables"). vitest runs in
# mode=test, so this file is picked up and never affects dev or production.
VITE_SERVER_URL=http://localhost:3000
VITE_COLLAB_URL=ws://localhost:1234
