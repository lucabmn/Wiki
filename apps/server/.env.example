# Local development env for `pnpm dev:server` (Docker installs use the root
# .env instead — see .env.example at the repo root).

# PostgreSQL connection string (matches the docker compose default: `pnpm db:start`)
DATABASE_URL=postgresql://postgres:password@localhost:5432/nilovon-wiki

# Secret used by Better Auth to sign sessions/tokens (min 32 chars).
# REQUIRED — placeholders are rejected at startup. Generate with:
#   openssl rand -base64 48
BETTER_AUTH_SECRET=

# Public base URL of this server. With an http:// URL auth cookies are issued
# as SameSite=Lax (works on localhost/LAN); with https:// they are issued as
# SameSite=None; Secure for cross-subdomain setups.
BETTER_AUTH_URL=http://localhost:3000

# Origin of the web app allowed by CORS (and trusted by Better Auth)
CORS_ORIGIN=http://localhost:3001

# development | production | test (defaults to development)
NODE_ENV=development

# Port the real-time collaboration service (apps/collab) listens on
COLLAB_PORT=1234

# Who gets the admin console at /admin. On a fresh database nobody holds the
# instance role, so the first admin has to be named here — this address is
# promoted at start, and stamped at registration if the account does not exist
# yet. Further admins are appointed inside the console. See DEPLOY.md.
#INITIAL_ADMIN_EMAIL=admin@example.com

# Support impersonation: bounded in time and audited on both ends. Set to false
# where the capability has to be provably absent rather than merely logged.
#IMPERSONATION_ENABLED=true
#IMPERSONATION_MAX_MINUTES=30
