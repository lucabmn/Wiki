# PostgreSQL connection string (matches the docker compose default: `pnpm db:start`)
DATABASE_URL=postgresql://postgres:password@localhost:5432/nilovon-wiki

# Secret used by Better Auth to sign sessions/tokens (min 32 chars). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Public base URL of this server. Auth cookies are issued with `SameSite=None; Secure`,
# so in production this MUST be an https:// URL (plain http only works on localhost).
BETTER_AUTH_URL=http://localhost:3000

# Origin of the web app allowed by CORS (and trusted by Better Auth)
CORS_ORIGIN=http://localhost:3001

# development | production | test (defaults to development)
NODE_ENV=development

# Port the real-time collaboration service (apps/collab) listens on
COLLAB_PORT=1234
