{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@nilovon-wiki/api": "workspace:*",
    "@nilovon-wiki/auth": "workspace:*",
    "@nilovon-wiki/db": "workspace:*",
    "@nilovon-wiki/editor": "workspace:*",
    "@nilovon-wiki/env": "workspace:*",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "archiver": "^8.0.0",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.2",
    "evlog": "catalog:",
    "hono": "catalog:",
    "pdfkit": "^0.19.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nilovon-wiki/config": "workspace:*",
    "@types/archiver": "^8.0.0",
    "@types/bun": "catalog:",
    "@types/pdfkit": "^0.17.6",
    "fflate": "^0.8.3",
    "tsdown": "^0.22.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
