# Local development env for `pnpm dev:collab` (Docker installs use the root
# .env instead — see .env.example at the repo root).
#
# The collab service verifies collab tokens with the same BETTER_AUTH_SECRET as
# the API server and persists Yjs snapshots to the same database.

DATABASE_URL=postgresql://postgres:password@localhost:5432/nilovon-wiki

# Must match apps/server/.env. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=

COLLAB_PORT=1234

# Only needed when collab runs on more than one instance — each instance keeps
# its documents in memory, so Redis pub/sub is what makes two editors served by
# different instances share one document. Leave empty for the single-container
# docker-compose deploy; REQUIRED for the Vercel deployment (see DEPLOY.md).
REDIS_URL=
