# The collaboration service reuses the server's environment: it verifies collab
# tokens with BETTER_AUTH_SECRET and persists Yjs snapshots to the same database.
# In local dev, copy the values from apps/server/.env into apps/collab/.env.

DATABASE_URL=postgresql://postgres:password@localhost:5432/nilovon-wiki
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
COLLAB_PORT=1234
