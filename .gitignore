# Build outputs
dist
build
*.tsbuildinfo

# apps/web/src/routeTree.gen.ts is generated by the TanStack Start plugin but is
# deliberately COMMITTED: `tsc` needs it, and only `vite build`/`dev` writes it.
# Ignoring it made `check-types` fail on a fresh clone, where the file does not
# exist yet and nothing orders the build before the typecheck.

